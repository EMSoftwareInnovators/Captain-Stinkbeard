  "ch4.aftermath": {
    "start": [
      { "spawn": "garrick", "x": 11, "y": 11, "facing": "left" },
      { "anim": "player", "name": "fallen" },
      { "wait": 900 },
      "The air is yellow. Not hazy. Not smoky. Yellow.",
      { "anim": "player", "name": "idle" },
      { "sfx": "cough_heavy" },
      "captain[coughing]: *cough* ...Grumblegut.",
      { "face": "garrick", "dir": "player" },
      "garrick[relieved]: Better out than in, Captain.",
      { "face": "player", "dir": "up" },
      { "camera": "pan", "x": 9, "y": 6, "duration": 1400 },
      "The gold has gone the colour of old mustard. The jewels have clouded over. The crown on its cushion is... sweating.",
      { "camera": "reset", "duration": 700 },
      "captain[devastated]: My... my treasure.",
      { "wait": 500 },
      { "face": "player", "dir": "right" },
      { "shake": 2, "duration": 300 },
      "captain[angry]: GRUMBLEGUT!",
      "garrick[nervous]: Captain, in fairness—",
      "captain[angry]: There IS no fairness! There's a CRAB on my DOOR and a CLOUD in my TREASURE!",
      "garrick[pretend]: The crab's gone, Captain. If that helps.",
      { "sfx": "thud" },
      "From the other side of the door comes a small, final clack. The crab has fainted.",
      "captain[coughing]: OUT. Now. Before we join it.",
