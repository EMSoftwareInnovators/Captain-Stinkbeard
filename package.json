{
  "name": "captain-stinkbeard",
  "version": "0.10.0",
  "private": true,
  "description": "Captain Stinkbeard \u2014 a retro-styled 2D pirate RPG (Phase 1 foundation + Story Phases 2 to 7).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run --exclude tests/regression.test.js",
    "test:regression": "vitest run tests/regression.test.js",
    "test:challenges": "vitest run tests/challenges.test.js",
    "test:difficulty": "vitest run tests/difficulty.test.js",
    "test:walkers": "vitest run _story",
    "test:walkers:fail-once": "node tools/walk-challenges.mjs failOnce",
    "test:walkers:difficulty": "node tools/walk-challenges.mjs failOnce brutal && node tools/walk-challenges.mjs failOnce deckhand",
    "validate": "vitest run tests/content.test.js",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:quick": "playwright test --grep-invert @story",
    "e2e:story": "playwright test --grep @story",
    "export": "node tools/export-assets.mjs",
    "economy": "node tools/economy.mjs",
    "consequences": "node tools/consequences.mjs",
    "regress": "node tools/regress.mjs summary",
    "regress:snapshot": "node tools/regress.mjs snapshot",
    "regress:compare": "node tools/regress.mjs compare",
    "regress:approve": "node tools/regress.mjs approve",
    "regress:crew": "node tools/regress.mjs crew",
    "regress:rooms": "node tools/regress.mjs rooms",
    "regress:coords": "node tools/regress.mjs coords",
    "regress:challenges": "node tools/regress.mjs challenges",
    "perf": "playwright test -c playwright.perf.config.js",
    "perf:bundle": "node tools/bundle-size.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
