{
  "name": "captain-stinkbeard",
  "version": "0.3.0",
  "private": true,
  "description": "Captain Stinkbeard — a retro-styled 2D pirate RPG (Phase 1 foundation + Story Phases 2 and 3).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run tests/content.test.js",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:quick": "playwright test --grep-invert @story",
    "e2e:story": "playwright test --grep @story",
    "export": "node tools/export-assets.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
